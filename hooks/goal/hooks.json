{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/goal\" --hook-context 2>/dev/null || true",
            "timeout": 5
          }
        ],
        "description": "Подмешать активную цель в контекст перед каждым запросом"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/goal\" --hook-stop 2>&1 || true",
            "timeout": 5
          }
        ],
        "description": "Напомнить в конце, что цель ещё не закрыта"
      }
    ]
  }
}
